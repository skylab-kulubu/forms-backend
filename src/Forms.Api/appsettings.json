{
  "Authentication": {
    "Issuer": "https://e.yildizskylab.com/realms/e-skylab",
    "Audience": "forms",
    "ClockSkewSeconds": 30,
    "MetadataTimeoutSeconds": 5
  },
  "AccountAccessGate": {
    "Mode": "off"
  },
  "Cors": {
    "AllowedOrigin": "http://localhost:3000"
  },
  "Redis": {
    "ConnectionString": "localhost:6379,defaultDatabase=1"
  },
  "Services": {
    "Users": {
      "BaseUrl": "http://core:8080"
    },
    "SkyMail": {
      "BaseUrl": "http://skymail:3000/v1/"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
